# Public Google OAuth web-client identifier.
GOOGLE_CLIENT_ID=

# Google OAuth client secret.
GOOGLE_CLIENT_SECRET=

# GitHub App user-authorization credentials.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Preferred: a GitHub App installed only on ktgmailorg/video-generator-rit
# with Repository administration: write.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=

# Optional fallback for initial testing only. Use a fine-grained token limited
# to the one repository with Administration: write; never use a broad PAT.
GITHUB_REPO_ADMIN_TOKEN=

# At least 32 cryptographically random bytes. Rotating it signs everyone out.
SESSION_SECRET=

# Exact deployed origin registered with Google and GitHub.
AUTH_BASE_URL=https://one-click-ai-video-pilot.vercel.app

GITHUB_REPOSITORY=ktgmailorg/video-generator-rit
