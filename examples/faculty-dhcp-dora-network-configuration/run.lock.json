        "input": {
          "instructions": "Clear, measured, and instructor-ready.",
          "text": "The client sends DHCPDISCOVER as a broadcast so any available server or relay on the local network can receive it. The message includes a transaction identifier that helps the client match later responses. If the server is on another subnet, a DHCP relay listens locally and forwards the request toward the configured server, adding information about the client's network. This matters because routers normally do not forward broadcasts. The relay provides controlled cross-subnet reach without placing a DHCP server on every VLAN."
        },
        "model": "edge-tts-7.2.8",
        "parameters": {},
        "schemaVersion": 1
