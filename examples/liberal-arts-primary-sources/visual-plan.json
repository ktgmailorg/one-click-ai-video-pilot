{
  "beats": [
    {
      "beatId": "beat-01",
      "shots": [
        {
          "id": "beat-01-shot-001",
          "phrase": "A primary source is evidence from the period or event being studied, but evidence does not interpret itself.",
          "type": "deterministic-svg"
        },
        {
          "id": "beat-01-shot-002",
          "phrase": "Begin with observation.",
          "type": "deterministic-svg"
        },
        {
          "id": "beat-01-shot-003",
          "phrase": "Separate what is actually present from what you expect or assume.",
          "type": "deterministic-svg"
        }
      ]
    },
    {
      "beatId": "beat-02",
      "shots": [
        {
          "id": "beat-02-shot-001",
          "phrase": "Next, reflect.",
          "type": "deterministic-svg"
        },
        {
          "id": "beat-02-shot-002",
          "phrase": "Who created the source, for whom, and for what purpose?",
          "type": "deterministic-svg"
        },
        {
          "id": "beat-02-shot-003",
          "phrase": "What was happening at the time?",
          "type": "deterministic-svg"
        },
        {
          "id": "beat-02-shot-004",
          "phrase": "What knowledge did the intended audience share?",
          "type": "deterministic-svg"
        }
      ]
    },
    {
      "beatId": "beat-03",
      "shots": [
        {
          "id": "beat-03-shot-001",
          "phrase": "Finally, turn uncertainty into questions.",
          "type": "deterministic-svg"
        },
        {
          "id": "beat-03-shot-002",
          "phrase": "Which claims need corroboration?",
          "type": "deterministic-svg"
        },
        {
          "id": "beat-03-shot-003",
          "phrase": "What related source could challenge this reading?",
          "type": "deterministic-svg"
        },
        {
          "id": "beat-03-shot-004",
          "phrase": "Strong analysis does not ask whether a source is simply biased or unbiased.",
          "type": "deterministic-svg"
        }
      ]
    }
  ],
  "episodeId": "how-to-evaluate-a-historical-primary-source",
  "schemaVersion": 1
}
